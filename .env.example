# Local development settings for docker compose. Copy to .env: cp .env.example .env
# These values only work against the local Postgres container; never put real credentials here.
POSTGRES_DATABASE=snowfishdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
APP_PORT=8000
# Only read by config.settings.production (e.g. to test it locally).
SECRET_KEY=local-dev-only-not-secret
